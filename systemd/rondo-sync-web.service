[Unit]
Description=Rondo Sync Dashboard Web Server
After=network.target
StartLimitBurst=5
StartLimitIntervalSec=300

[Service]
Type=simple
User=rondo-sync
Group=rondo-sync
WorkingDirectory=/srv/rondo-sync
ExecStart=/usr/local/bin/node /srv/rondo-sync/lib/web-server.js
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rondo-sync-web

# Stop only the web server on restart, not detached sync children
# spawned from POST /api/pipeline/:name/start. Without this, an in-flight
# Sportlink/Laposta sync gets SIGTERMed mid-flight on every deploy.
KillMode=process

# Security hardening (INFRA-04: non-root, minimal permissions)
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

# Environment
Environment=NODE_ENV=production
Environment=PATH=/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=multi-user.target
